{
  "name": "bpl20-claim-site",
  "private": true,
  "version": "0.0.1",
  "description": "Static claim site: buyers pay and receive a BRC-20 transfer inscription in one atomic transaction (PSBT).",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts src/admin.ts src/stats.ts --bundle --format=esm --target=es2020 --inject:./src/buffer-shim.ts --define:global=globalThis --outdir=js",
    "lots": "tsx scripts/build-lots.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^2.0.0",
    "bitcoinjs-lib": "^6.1.7",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ecpair": "^3.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
